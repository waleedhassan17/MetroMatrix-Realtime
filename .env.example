# ============================================================================
# metromatrix-realtime — environment
#
# THE CONSISTENCY CONTRACT
# This service and the main MetroMatrix backend never call each other. They stay
# consistent by sharing EXACTLY TWO values, which must be byte-identical to the
# main backend's:
#   MONGODB_URI  — same cluster AND same database name
#   JWT_SECRET   — main signs the token, this service verifies it
# Get both from the main backend's own environment. Never commit real values.
# ============================================================================

# --- REQUIRED: must match the main backend exactly --------------------------
MONGODB_URI=
JWT_SECRET=

# --- JWT claim names --------------------------------------------------------
# The main backend signs: jwt.sign({ id, userType, email, ... }, JWT_SECRET)
# so these defaults are already correct and normally need no override.
#
# NOTE: JWT_ROLE_CLAIM is used ONLY by POST /api/users/me/push-token, to decide
# whether the token belongs to a User or a Provider. Every room-scoped role
# (who is the customer, who is the provider/doctor) is derived from actual
# booking/appointment membership in the database — see src/utils/access.js.
# Doctors sign in as userType 'provider', so this claim can never distinguish a
# doctor from a home-service provider anyway.
JWT_ID_CLAIM=id
JWT_ROLE_CLAIM=userType

# --- Server -----------------------------------------------------------------
# Heroku injects PORT; do not set it there.
PORT=5000
NODE_ENV=development

# Comma-separated allowed origins, or * for any. Applies to both the REST layer
# and the Socket.IO handshake.
# A React Native app sends no Origin header, so * is normal here; tighten it
# only if you also serve a browser client.
SOCKET_CORS_ORIGINS=*

# --- Push (optional) --------------------------------------------------------
# Only needed if your Expo project enforces push security.
# https://expo.dev/accounts/<account>/settings/access-tokens
EXPO_ACCESS_TOKEN=
