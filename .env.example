# ============================================================================
# metromatrix-realtime — environment
#
# THE CONSISTENCY CONTRACT
# This service and the main MetroMatrix backend never call each other. They stay
# consistent by sharing EXACTLY TWO values, which must be byte-identical to the
# main backend's:
#   MONGODB_URI  — same cluster AND same database name
#   JWT_SECRET   — main signs the token, this service verifies it
# Get both from the main backend's own environment. Never commit real values.
# ============================================================================

# --- REQUIRED: must match the main backend exactly --------------------------
MONGODB_URI=
JWT_SECRET=

# --- JWT claim names --------------------------------------------------------
# The main backend signs: jwt.sign({ id, userType, email, ... }, JWT_SECRET)
# so these defaults are already correct and normally need no override.
#
# NOTE: JWT_ROLE_CLAIM is used ONLY by POST /api/users/me/push-token, to decide
# whether the token belongs to a User or a Provider. Every room-scoped role
# (who is the customer, who is the provider/doctor) is derived from actual
# booking/appointment membership in the database — see src/utils/access.js.
# Doctors sign in as userType 'provider', so this claim can never distinguish a
# doctor from a home-service provider anyway.
JWT_ID_CLAIM=id
JWT_ROLE_CLAIM=userType

# --- Server -----------------------------------------------------------------
# Heroku injects PORT; do not set it there.
PORT=5000
NODE_ENV=development

# Comma-separated allowed origins, or * for any. Applies to both the REST layer
# and the Socket.IO handshake.
# A React Native app sends no Origin header, so * is normal here; tighten it
# only if you also serve a browser client.
SOCKET_CORS_ORIGINS=*

# --- Internal bridge (REQUIRED) ---------------------------------------------
# Shared secret the MAIN BACKEND presents on POST /api/internal/emit, which is
# how server-originated room events (booking status, appointment status,
# payments, and later video-call start/end) reach a connected client. The main
# backend cannot emit them itself — it runs on Vercel and holds no socket.
#
# Set the SAME value as INTERNAL_API_KEY in the main backend's env. Minimum 16
# characters.
#
# Unset, the service still boots and chat/calling keep working — only the emit
# bridge is disabled (503), so booking/appointment status, payments and
# video-call events stop reaching clients. It is warned about at boot and logged
# on every refusal, and the main backend logs each failed publish. Deliberately
# not fatal: a forgotten variable must not take messaging down.
#   openssl rand -hex 32
INTERNAL_API_KEY=

# --- Push (optional) --------------------------------------------------------
# Only needed if your Expo project enforces push security.
# https://expo.dev/accounts/<account>/settings/access-tokens
EXPO_ACCESS_TOKEN=

# --- Cloudflare Realtime TURN (in-app calling) ------------------------------
# WebRTC needs a relay whenever the two devices cannot reach each other
# directly, which on mobile carrier networks is most of the time. The app NEVER
# holds these: it asks GET /api/turn/credentials and this service mints
# short-lived ICE servers from Cloudflare per call.
#
# Unset, the service still boots and chat still works — only /turn/credentials
# 503s, so calls cannot connect. Warned about at boot.
#   Dashboard: Cloudflare > Realtime > TURN > create a key
CF_TURN_TOKEN_ID=
CF_TURN_API_TOKEN=

# Lifetime of a minted credential, seconds. Default 3600. Long enough that a
# call never expires mid-conversation, short enough that a leaked credential
# stops working the same day.
TURN_TTL_SECONDS=3600
