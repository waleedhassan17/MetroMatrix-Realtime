# ─────────────────────────────────────────────────────────────────────────────
# COPY THESE TWO VALUES *VERBATIM* FROM YOUR MAIN MetroMatrix BACKEND .env.
# They MUST match, or the "register on backend A, call via backend B" flow breaks.
# (See README → "The consistency contract".)
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=          # SAME cluster AND SAME database name as the main backend
JWT_SECRET=           # SAME secret the main backend signs its ACCESS tokens with

# ── This service's own settings ──
PORT=5000             # Heroku sets this automatically; keep the fallback for local
NODE_ENV=production

# Comma-separated allowed origins for sockets + REST. Mobile-only can use *,
# but set it explicitly if you also have a web client.
SOCKET_CORS_ORIGINS=*

# Optional but recommended: Expo push security token (expo.dev → Access Tokens).
EXPO_ACCESS_TOKEN=

# Which claim in the JWT holds the user id / role. MATCH your main backend's
# token payload (whatever it puts in jwt.sign({...})). Common: id | _id | userId.
JWT_ID_CLAIM=id
JWT_ROLE_CLAIM=role
