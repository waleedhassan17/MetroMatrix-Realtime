{
  "name": "metromatrix-realtime",
  "version": "1.0.0",
  "description": "MetroMatrix realtime service — chat + call signalling over Socket.IO. Shares MongoDB and JWT_SECRET with the main backend; the two services never call each other.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ensure-indexes": "node scripts/ensureIndexes.js",
    "verify-token": "node scripts/verifyToken.js",
    "verify-realtime": "node scripts/verifyPresenceAndCalls.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3"
  }
}
